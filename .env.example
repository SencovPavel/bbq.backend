DATABASE_URL=postgresql://user:password@localhost:5432/picnic
PORT=3001
PUBLIC_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
# HEALTH_VERBOSE=true — показывать clients в /health

# Telegram bot
BOT_TOKEN=your_telegram_bot_token
TG_WEBHOOK_SECRET=random_secret_for_webhook
# Обязателен в production (fail-closed на /tg-webhook)

# MAX webhook (заголовок X-Max-Bot-Api-Secret), обязателен если задан MAX_TOKEN
MAX_WEBHOOK_SECRET=random_max_webhook_secret

# Rate limit: Redis для нескольких инстансов (опционально)
# REDIS_URL=redis://localhost:6379

# Доверять X-Forwarded-For только за reverse proxy
# TRUST_PROXY=true

# Dev-only auto login (NODE_ENV !== production); при dev-login всегда is_superadmin=TRUE
DEV_USER_EMAIL=dev@kotyol.local
DEV_USER_PASSWORD=dev12345
DEV_USER_NAME=Тестовый пользователь

# MAX Messenger bot (опционально)
MAX_TOKEN=your_max_token

# AI agent
ANTHROPIC_API_KEY=your_anthropic_api_key

# Yandex OAuth (oauth.yandex.ru)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Apple Sign In (developer.apple.com, опционально, требует HTTPS)
APPLE_CLIENT_ID=com.yourapp.kotyol
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
